# GA4 Data API — numeric Property ID (Admin → Property settings), NOT G-XXXXXXXX
GA4_PROPERTY_ID=YOUR_NUMERIC_PROPERTY_ID
GA4_REPORT_DAYS=7

# Path to service-account JSON (default: secrets/ga4-service-account.json)
GOOGLE_APPLICATION_CREDENTIALS=secrets/ga4-service-account.json

# Optional: email the report (Gmail = smtp.gmail.com + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
REPORT_FROM=you@gmail.com
REPORT_TO=you@gmail.com

# Formspree Forms API (newsletter submission counts) — Professional/Business only
# Dashboard → form mnppkppz → Settings → enable HTTP API → copy Read-only key
# Free plan: no API; count subscribers in the Formspree UI instead.
FORMSPREE_FORM_ID=mnppkppz
FORMSPREE_API_KEY=

# Spotify plays: NO public API for creator episode plays.
# Use https://creators.spotify.com (Spotify for Podcasters) per show → Analytics / CSV export.
# Do not put Spotify passwords or session cookies here.
